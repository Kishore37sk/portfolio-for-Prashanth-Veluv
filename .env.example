# Public production URL (no trailing slash). Used for canonical, Open Graph,
# JSON-LD, robots.txt and sitemap.xml. Set this in Vercel/Netlify too.
VITE_SITE_URL=https://prashanth-velu-v.vercel.app

# Optional: a form endpoint that accepts JSON POSTs (e.g. Formspree, Getform,
# or your own Express route). When unset, the contact form opens a pre-filled
# email in the visitor's mail app instead (mailto), and never claims to "send".
VITE_CONTACT_ENDPOINT=
